 from PySide.QtCore import QT_TRANSLATE_NOOP  # for translations
 
 
+# A flattening is exact only for a developable surface. The flattener scales its result to the
+# area of the 3D mesh, so the areas always agree; report how much the edge lengths changed.
+DISTORTION_WARNING = 0.01
+
+
+def report_distortion(flattener, what):
+    d = flattener.getDistortion()
+    text = "{}: edge lengths changed by up to {:.3%} (rms {:.3%}), {} flipped triangles\n".format(
+        what, d["max_edge_strain"], d["rms_edge_strain"], d["flipped_triangles"]
+    )
+    if d["max_edge_strain"] > DISTORTION_WARNING or d["flipped_triangles"] > 0:
+        App.Console.PrintWarning(text)
+    else:
+        App.Console.PrintMessage(text)
+    return d
+
+
 class BaseCommand(object):
     def __init__(self):
