+// How far the flat mesh is from an isometric image of the 3D mesh. The flattener scales its
+// result to the 3D area (LscmRelax::transform), so the area ratio alone says little about length
+// errors; edge strains do. Each triangle contributes its three edges (shared edges count twice).
+// begin computeFlatDistortion
+struct FlatDistortion
+{
+    double maxEdgeStrain = 0.0;  // max |flat length / 3D length - 1|
+    double rmsEdgeStrain = 0.0;
+    double area = 0.0;           // 3D mesh
+    double flatArea = 0.0;
+    long flippedTriangles = 0;   // flat triangles oriented against the majority
+};
+
+FlatDistortion computeFlatDistortion(const FaceUnwrapper& fu)
+{
+    if (fu.ze_nodes.rows() == 0 || fu.ze_nodes.rows() != fu.xyz_nodes.rows()) {
+        throw std::runtime_error("no flat nodes: call findFlatNodes() first");
+    }
+    FlatDistortion d;
+    double sumSq = 0.0;
+    long count = 0, positive = 0, negative = 0;
+    for (Eigen::Index i = 0; i < fu.tris.rows(); i++) {
+        const long t[3] = {fu.tris(i, 0), fu.tris(i, 1), fu.tris(i, 2)};
+        for (int j = 0; j < 3; j++) {
+            const long a = t[j];
+            const long b = t[(j + 1) % 3];
+            const double l3 = (fu.xyz_nodes.row(a) - fu.xyz_nodes.row(b)).norm();
+            const double l2 = (fu.ze_nodes.row(a) - fu.ze_nodes.row(b)).norm();
+            if (l3 > 0.0) {
+                const double s = l2 / l3 - 1.0;
+                d.maxEdgeStrain = std::max(d.maxEdgeStrain, std::abs(s));
+                sumSq += s * s;
+                ++count;
+            }
+        }
+        const Eigen::Vector3d e1 = (fu.xyz_nodes.row(t[1]) - fu.xyz_nodes.row(t[0])).transpose();
+        const Eigen::Vector3d e2 = (fu.xyz_nodes.row(t[2]) - fu.xyz_nodes.row(t[0])).transpose();
+        d.area += 0.5 * e1.cross(e2).norm();
+        const Eigen::Vector2d f1 = (fu.ze_nodes.row(t[1]) - fu.ze_nodes.row(t[0])).transpose();
+        const Eigen::Vector2d f2 = (fu.ze_nodes.row(t[2]) - fu.ze_nodes.row(t[0])).transpose();
+        const double c = f1.x() * f2.y() - f1.y() * f2.x();
+        d.flatArea += 0.5 * std::abs(c);
+        if (c > 0.0) {
+            ++positive;
+        }
+        else if (c < 0.0) {
+            ++negative;
+        }
+    }
+    d.rmsEdgeStrain = count > 0 ? std::sqrt(sumSq / static_cast<double>(count)) : 0.0;
+    d.flippedTriangles = std::min(positive, negative);
+    return d;
+}
+// end computeFlatDistortion
+
+py::dict getDistortionPy(const FaceUnwrapper& fu)
+{
+    const FlatDistortion d = computeFlatDistortion(fu);
+    py::dict result;
+    result["max_edge_strain"] = d.maxEdgeStrain;
+    result["rms_edge_strain"] = d.rmsEdgeStrain;
+    result["area"] = d.area;
+    result["flat_area"] = d.flatArea;
+    result["flipped_triangles"] = d.flippedTriangles;
+    return result;
+}
+
 
