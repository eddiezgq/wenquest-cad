+// Relative tolerance for telling a rigid or similarity matrix from one that only gp_GTrsf can hold.
+// Rounding in placements composed in double precision stays many orders of magnitude below it.
+static constexpr double MatrixScaleTolerance = 1e-6;
+
 void TopoShape::convertTogpTrsf(const Base::Matrix4D& mtrx, gp_Trsf& trsf)
 {
+    // gp_Trsf holds only rotations, mirrors and uniform scaling. gp_Trsf::SetValues() divides any
+    // other matrix by the cube root of its determinant and then orthogonalizes its columns: a
+    // non-uniform scaling becomes a uniform one and a shear is dropped, without an error.
+    auto type = mtrx.hasScale(MatrixScaleTolerance);
+    if (type != Base::ScaleType::NoScaling && type != Base::ScaleType::Uniform) {
+        throw Base::ValueError(
+            "Matrix with non-uniform scaling or shear cannot be applied as a placement; "
+            "use transformGeometry() or transformShape(matrix, copy, checkScale=True)"
+        );
+    }
     trsf.SetValues(
         mtrx[0][0],
         mtrx[0][1],
@@ -669,6 +683,16 @@ gp_Trsf TopoShape::convert(const Base::Matrix4D& mtrx)
 
