diff --git a/src/Mod/Part/App/TopoShapeFacePyImp.cpp b/src/Mod/Part/App/TopoShapeFacePyImp.cpp
index f3c9475366..ed9515ef12 100644
--- a/src/Mod/Part/App/TopoShapeFacePyImp.cpp
+++ b/src/Mod/Part/App/TopoShapeFacePyImp.cpp
@@ -571,6 +571,17 @@ PyObject* TopoShapeFacePy::curvatureAt(PyObject* args) const
         return nullptr;
     }
 
+    // BRepLProp_SLProps measures curvature against the normal of the underlying surface;
+    // normalAt() returns the normal of the face, reversed for a reversed face. Give the
+    // curvatures against the same normal, so that a hole and a boss of the same radius differ
+    // in sign. Reversing the normal negates both curvatures and swaps min and max.
+    if (f.Orientation() == TopAbs_REVERSED) {
+        double kmin = static_cast<double>(Py::Float(tuple.getItem(0)));
+        double kmax = static_cast<double>(Py::Float(tuple.getItem(1)));
+        tuple.setItem(0, Py::Float(-kmax));
+        tuple.setItem(1, Py::Float(-kmin));
+    }
+
     return Py::new_reference_to(tuple);
 }
 
