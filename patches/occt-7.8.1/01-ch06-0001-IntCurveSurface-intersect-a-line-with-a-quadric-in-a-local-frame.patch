+  // Line - elementary quadric (cylinder, sphere, cone) intersection solved in a frame
+  // translated to the quadric's location. IntAna_Quadric holds the implicit equation in
+  // global coordinates, whose constant term carries |location|^2: far from the origin it
+  // swamps the radius (relative error ~ eps * |location|^2 / radius^2) and the roots are
+  // lost. The parameter on the line does not change under the translation; the points
+  // are moved back before the surface parameters are computed.
+  auto aLinQuadricLocal = [&](const IntAna_Quadric& theLocalQuadric, const gp_Vec& theShift)
+  {
+    IntAna_IntConicQuad anInter(Line.Translated(-theShift), theLocalQuadric);
+    if (!anInter.IsDone() || anInter.IsInQuadric() || anInter.IsParallel())
+    {
+      // no points to move: keep the flags handling of AppendIntAna
+      AppendIntAna(curve, surface, anInter);
+      return;
+    }
+    for (Standard_Integer i = 1; i <= anInter.NbPoints(); i++)
+    {
+      const gp_Pnt aP = anInter.Point(i).Translated(theShift);
+      const Standard_Real aW = anInter.ParamOnConic(i);
+      Standard_Real aU = 0.0, aV = 0.0;
+      IntCurveSurface_ComputeParamsOnQuadric(surface, aP, aU, aV);
+      AppendPoint(curve, aW, surface, aU, aV);
+    }
+  };
+
   GeomAbs_SurfaceType SurfaceType = TheSurfaceTool::GetType(surface);
   Standard_Boolean isAnaProcessed = Standard_True;
