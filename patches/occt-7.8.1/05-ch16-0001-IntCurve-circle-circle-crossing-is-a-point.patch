+      const Standard_Real aDB =
+        ElCLib::Value(SolutionC1[i].Bsup, Circle1).Distance(Circle2.Location()) - R2;
+      isCrossing = (aDA * aDB < 0.0);
+    }
+    if(isCrossing ||
+       (((R1 * SolutionC1[i].Length()) <=Tol2) && 
+              ((R2 * SolutionC2[i].Length())<=Tol2)))
     {
