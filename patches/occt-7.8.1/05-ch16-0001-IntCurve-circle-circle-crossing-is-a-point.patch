+    // An interval produced by a transversal crossing must be reduced to a point whatever its
+    // length: its length is about 2*Tol/sin(angle) and exceeds Tol2 when the curves cross at an
+    // angle below about 40 degrees.  Circle1 then passes from one side of Circle2 to the other,
+    // i.e. the signed distances to Circle2 at the two ends of the interval have opposite signs.
+    // A tangential contact keeps the same sign and is left unchanged.
+    Standard_Boolean isCrossing = Standard_False;
+    if (SolutionC1[i].Length() > 0.0 && SolutionC1[i].Length() < M_PI)
