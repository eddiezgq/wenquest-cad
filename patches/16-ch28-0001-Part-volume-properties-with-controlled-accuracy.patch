+void TopoShape::volumeProperties(const TopoDS_Shape& shape, GProp_GProps& props, bool volumeOnly)
+{
+    // The default rule is accurate on planes and the elementary quadrics; keep it there, so that the
+    // results for such shapes do not change at all (e.g. principal axes of equal moments).
+    bool elementary = true;
+    for (TopExp_Explorer xp(shape, TopAbs_FACE); xp.More() && elementary; xp.Next()) {
+        switch (BRepAdaptor_Surface(TopoDS::Face(xp.Current()), false).GetType()) {
+            case GeomAbs_Plane:
+            case GeomAbs_Cylinder:
+            case GeomAbs_Cone:
+            case GeomAbs_Sphere:
+            case GeomAbs_Torus:
+                break;
+            default:
+                elementary = false;
+        }
+    }
+    if (elementary) {
+        BRepGProp::VolumeProperties(shape, props);
+        return;
+    }
+    if (volumeOnly) {
+        GProp_GProps gk;
+        if (BRepGProp::VolumePropertiesGK(shape, gk, 1.0e-9, false, true, false, false) >= 0.0) {
+            props = gk;
+            return;
+        }
+    }
+    else {
+        GProp_GProps adaptive;
+        if (BRepGProp::VolumeProperties(shape, adaptive, 1.0e-9) >= 0.0) {
+            props = adaptive;
+            return;
+        }
+    }
+    BRepGProp::VolumeProperties(shape, props);
+}
+
