diff --git a/src/Mod/PartDesign/App/FeatureChamfer.cpp b/src/Mod/PartDesign/App/FeatureChamfer.cpp
index fdec798ade..71712a4d0c 100644
--- a/src/Mod/PartDesign/App/FeatureChamfer.cpp
+++ b/src/Mod/PartDesign/App/FeatureChamfer.cpp
@@ -183,6 +183,15 @@ App::DocumentObjectExecReturn* Chamfer::execute()
                 Precision::Confusion(),
                 TopAbs_SHAPE
             );
+            if (!BRepAlgo::IsValid(aLarg, shape.getShape(), Standard_False, Standard_False)) {
+                // The kernel may report success for a size the geometry cannot take (e.g. a radius
+                // larger than half the thinnest wall); the result is then an invalid solid whose
+                // volume can exceed the original. Do not store it.
+                return new App::DocumentObjectExecReturn(QT_TRANSLATE_NOOP(
+                    "Exception",
+                    "Chamfer result is not a valid solid. The size may be too large for the selected edges."
+                ));
+            }
         }
 
         // store shape before refinement
