+bool Part::offsetCollapsesCurvedFace(const TopoDS_Shape& shape, double offset, double& radius)
+{
+    for (TopExp_Explorer xp(shape, TopAbs_FACE); xp.More(); xp.Next()) {
+        const TopoDS_Face& face = TopoDS::Face(xp.Current());
+        BRepAdaptor_Surface surf(face);
+        double u = 0.5 * (surf.FirstUParameter() + surf.LastUParameter());
+        double v = 0.5 * (surf.FirstVParameter() + surf.LastVParameter());
+        BRepLProp_SLProps props(surf, u, v, 1, Precision::Confusion());
+        if (!props.IsNormalDefined()) {
+            continue;
+        }
+        gp_Dir normal = props.Normal();
+        if (face.Orientation() == TopAbs_REVERSED) {
+            normal.Reverse();
+        }
+        double rho = 0.0;
+        gp_Vec radial;
+        switch (surf.GetType()) {
+            case GeomAbs_Cylinder: {
+                gp_Cylinder cyl = surf.Cylinder();
+                gp_Vec w(cyl.Location(), props.Value());
+                gp_Vec axis(cyl.Axis().Direction());
+                radial = w - axis * w.Dot(axis);
+                rho = cyl.Radius();
+                break;
+            }
+            case GeomAbs_Sphere: {
+                gp_Sphere sph = surf.Sphere();
+                radial = gp_Vec(sph.Location(), props.Value());
+                rho = sph.Radius();
+                break;
+            }
+            case GeomAbs_Torus: {
+                gp_Torus tor = surf.Torus();
+                gp_Vec w(tor.Location(), props.Value());
+                gp_Vec axis(tor.Axis().Direction());
+                gp_Vec inPlane = w - axis * w.Dot(axis);
+                if (inPlane.Magnitude() < Precision::Confusion()) {
+                    continue;
+                }
+                gp_Pnt tube = tor.Location().Translated(inPlane.Normalized() * tor.MajorRadius());
+                radial = gp_Vec(tube, props.Value());
+                rho = tor.MinorRadius();
+                break;
+            }
+            default:
+                continue;
+        }
+        bool convex = radial.Dot(gp_Vec(normal)) > 0.0;
+        bool shrinks = (offset < 0.0 && convex) || (offset > 0.0 && !convex);
+        if (shrinks && std::fabs(offset) >= rho - Precision::Confusion()) {
+            radius = rho;
+            return true;
+        }
+    }
+    return false;
+}
