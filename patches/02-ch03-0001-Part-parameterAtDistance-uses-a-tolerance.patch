@@ -554,7 +554,11 @@ PyObject* Curve2dPy::parameterAtDistance(PyObject* args)
                 return nullptr;
             }
             Geom2dAdaptor_Curve adapt(c);
-            GCPnts_AbscissaPoint abscissaPoint(adapt, abscissa, u);
+            // Without a tolerance GCPnts_AbscissaPoint integrates the arc length with one fixed-order
+            // Gauss rule over the whole parameter range (no error control): on an ellipse the point
+            // can be off by a large fraction of a millimetre. Use the same tolerance as
+            // Edge.getParameterByLength() and Curve.length().
+            GCPnts_AbscissaPoint abscissaPoint(Precision::Confusion(), adapt, abscissa, u);
             double parm = abscissaPoint.Parameter();
             return PyFloat_FromDouble(parm);
         }
